# Copy to .env and supply your own endpoints and credentials.
# .env is excluded from version control.
VOICETRAIL_ASR_URL=https://asr.example.invalid
VOICETRAIL_ASR_API_KEY=replace-with-your-asr-token
VOICETRAIL_WRITER_URL=https://writer.example.invalid/v1/chat/completions
VOICETRAIL_WRITER_API_KEY=
VOICETRAIL_WRITER_MODEL=qwen3
VOICETRAIL_READER_URL=https://reader.example.invalid/v1/chat/completions
VOICETRAIL_READER_API_KEY=
VOICETRAIL_READER_MODEL_NAME=qwen3
VOICETRAIL_READER_MODEL_PATH=
VOICETRAIL_READER_DEVICE=cuda:0
VOICETRAIL_READER_GPU_FRACTION=0.45
VOICETRAIL_READER_CPU_THREADS=4
VOICETRAIL_E5_MODEL=intfloat/multilingual-e5-large
